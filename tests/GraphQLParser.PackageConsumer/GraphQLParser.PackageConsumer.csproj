<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);PACKAGE_VERIFICATION</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="GraphQLParser" />
    <Compile Include="../GraphQLParser.PublicApiConsumer/Program.cs" Link="Program.cs" />
    <None Include="../../docs/public-api-contract.json" Link="public-api-contract.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../docs/package-api-allowlist.json" Link="package-api-allowlist.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
