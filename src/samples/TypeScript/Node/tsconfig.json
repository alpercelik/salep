{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "outDir": "dist",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "jsx": "preserve"
  },
  "include": [
    "Generated/**/*.ts",
    "*.ts",
    "*.tsx",
    "MaskedGenerated/**/*.ts"
  ]
}
