    [Fact]
    public async Task ExecuteAsync_Preserves_GraphQL_Errors()
    {
        using var handler = new TestHttpMessageHandler(_ => TestHttpMessageHandler.JsonResponse({{ settings.error_response_literal }}));
        using var httpClient = new HttpClient(handler);
        var client = new {{ settings.client_name }}(httpClient, new Uri("https://example.test/graphql"));
        var response = await client.ExecuteAsync(new DummyOperation(false, null), TestContext.Current.CancellationToken);
        Assert.Equal("fixture error", Assert.Single(response.Errors!).Message);
    }
