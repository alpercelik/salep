    [Fact]
    public async Task ExecuteBatchAsync_Sends_Array_Payload()
    {
        using var handler = new TestHttpMessageHandler(_ => TestHttpMessageHandler.JsonResponse({{ settings.batch_response_literal }}));
        using var httpClient = new HttpClient(handler);
        var client = new {{ settings.client_name }}(httpClient, new Uri("https://example.test/graphql"));
        var operation = new DummyOperation(true, null);
        _ = await client.ExecuteBatchAsync(new {{ settings.operation_interface }}<DummyResponse, DummyVariables>[] { operation, operation }, TestContext.Current.CancellationToken);
        using var document = JsonDocument.Parse(handler.ContentText!);
        Assert.Equal(JsonValueKind.Array, document.RootElement.ValueKind);
        Assert.Equal(2, document.RootElement.GetArrayLength());
    }
