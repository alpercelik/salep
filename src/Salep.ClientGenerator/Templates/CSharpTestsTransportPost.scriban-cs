    [Fact]
    public async Task ExecuteAsync_SerializesOperationPayload()
    {
        using var handler = new TestHttpMessageHandler(_ => TestHttpMessageHandler.JsonResponse({{ settings.transport_response_literal }}));
        using var httpClient = new HttpClient(handler);
        var client = new {{ settings.client_name }}(httpClient, new Uri("https://example.test/graphql"));
        var operation = new DummyOperation(false, new DummyVariables("value"));
        _ = await client.ExecuteAsync(operation, TestContext.Current.CancellationToken);
        using var document = JsonDocument.Parse(handler.ContentText!);
        Assert.Equal("TestOp", document.RootElement.GetProperty("operationName").GetString());
        Assert.Contains("TestOp", document.RootElement.GetProperty("query").GetString());
        Assert.Equal("value", document.RootElement.GetProperty("variables").GetProperty("value").GetString());
    }
