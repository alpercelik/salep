<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Title>Salep GraphQL Parser</Title>
    <Description>Standalone GraphQL lexer and parser for .NET, with immutable syntax trees, diagnostics, visitors, rewriting, printing, and UTF-8 support.</Description>
    <PackageTags>graphql;parser;lexer;syntax;ast;dotnet</PackageTags>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageReadmeFile>package-readme.md</PackageReadmeFile>
    <PackageId>Salep.GraphQLParser</PackageId>
    <NoWarn>CA1000;CA1720</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../docs/parser/package-readme.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
