    "Queries": {
      "CommentAdded": "subscription CommentAdded {\n  commentAdded {\n    ...CommentCore\n  }\n}\n\nfragment UserCore on User @opTag(name: \u0022frag-user\u0022) {\n  id\n  name\n  role\n  createdAt\n}\n\nfragment CommentCore on Comment {\n  id\n  body\n  author {\n    ...UserCore\n  }\n}",
      "CreatePostAliased": "mutation CreatePostAliased {\n  first: createPost(input: {title: \u0022A\u0022}) {\n    id\n    title\n  }\n  second: createPost(input: {title: \u0022B\u0022, content: \u0022B body\u0022}) {\n    id\n    title\n    content\n  }\n}",
      "CreatePostSimple": "mutation CreatePostSimple($title: String!) @opTag(name: \u0022create-simple\u0022) {\n  createPost(input: {title: $title}) @opTag(name: \u0022create-field\u0022) {\n    ...PostCore\n  }\n}\n\nfragment UserCore on User @opTag(name: \u0022frag-user\u0022) {\n  id\n  name\n  role\n  createdAt\n}\n\nfragment PostCore on Post @opTag(name: \u0022frag-post\u0022) {\n  id\n  title\n  content\n  author {\n    ...UserCore @opTag(name: \u0022spread-user\u0022)\n  }\n}",
      "CreatePostWithContent": "mutation CreatePostWithContent($title: String!, $content: String) {\n  createPost(input: {title: $title, content: $content}) {\n    ...PostCore\n  }\n}\n\nfragment UserCore on User @opTag(name: \u0022frag-user\u0022) {\n  id\n  name\n  role\n  createdAt\n}\n\nfragment PostCore on Post @opTag(name: \u0022frag-post\u0022) {\n  id\n  title\n  content\n  author {\n    ...UserCore @opTag(name: \u0022spread-user\u0022)\n  }\n}",
      "DeletePosts": "mutation DeletePosts($ids: [ID!] = [\u00221\u0022, \u00222\u0022]) {\n  deleted: deletePosts(ids: $ids) {\n    ...PostCore\n  }\n}\n\nfragment UserCore on User @opTag(name: \u0022frag-user\u0022) {\n  id\n  name\n  role\n  createdAt\n}\n\nfragment PostCore on Post @opTag(name: \u0022frag-post\u0022) {\n  id\n  title\n  content\n  author {\n    ...UserCore @opTag(name: \u0022spread-user\u0022)\n  }\n}",
      "EchoList": "query EchoList($values: [String!]! = [\u0022a\u0022, \u0022b\u0022]) {\n  echoed: echoList(values: $values) @opTag(name: \u0022echoed\u0022)\n}",
      "NodeById": "query NodeById($id: ID! = \u00221\u0022) {\n  byId: node(id: $id) {\n    __typename\n    ... on User @include(if: true) {\n      ...UserCore\n    }\n    ... on Post {\n      ...PostCore\n    }\n    ... on Comment {\n      ...CommentCore\n    }\n  }\n}\n\nfragment UserCore on User @opTag(name: \u0022frag-user\u0022) {\n  id\n  name\n  role\n  createdAt\n}\n\nfragment PostCore on Post @opTag(name: \u0022frag-post\u0022) {\n  id\n  title\n  content\n  author {\n    ...UserCore @opTag(name: \u0022spread-user\u0022)\n  }\n}\n\nfragment CommentCore on Comment {\n  id\n  body\n  author {\n    ...UserCore\n  }\n}",
      "PostCreatedFull": "subscription PostCreatedFull @opTag(name: \u0022post-full\u0022) {\n  postCreated(role: USER) {\n    ...PostCore\n  }\n}\n\nfragment UserCore on User @opTag(name: \u0022frag-user\u0022) {\n  id\n  name\n  role\n  createdAt\n}\n\nfragment PostCore on Post @opTag(name: \u0022frag-post\u0022) {\n  id\n  title\n  content\n  author {\n    ...UserCore @opTag(name: \u0022spread-user\u0022)\n  }\n}",
      "PostCreatedMinimal": "subscription PostCreatedMinimal {\n  postCreated {\n    id\n    title\n  }\n}",
      "PostsByIds": "query PostsByIds($ids: [ID!]! = [\u00221\u0022, \u00222\u0022], $allowMissing: Boolean = false) {\n  posts(ids: $ids, allowMissing: $allowMissing) {\n    ...PostCore\n  }\n}\n\nfragment UserCore on User @opTag(name: \u0022frag-user\u0022) {\n  id\n  name\n  role\n  createdAt\n}\n\nfragment PostCore on Post @opTag(name: \u0022frag-post\u0022) {\n  id\n  title\n  content\n  author {\n    ...UserCore @opTag(name: \u0022spread-user\u0022)\n  }\n}",
      "SearchUsersAndPosts": "query SearchUsersAndPosts($text: String!) @opTag(name: \u0022search\u0022) {\n  search(text: $text, options: {text: \u0022x\u0022, tags: [\u0022a\u0022]}) {\n    __typename\n    ... on User @opTag(name: \u0022user-frag\u0022) {\n      ...UserCore\n    }\n    ... on Post @opTag(name: \u0022post-frag\u0022) {\n      ...PostCore\n    }\n    ... on Comment {\n      ...CommentCore\n    }\n  }\n}\n\nfragment UserCore on User @opTag(name: \u0022frag-user\u0022) {\n  id\n  name\n  role\n  createdAt\n}\n\nfragment PostCore on Post @opTag(name: \u0022frag-post\u0022) {\n  id\n  title\n  content\n  author {\n    ...UserCore @opTag(name: \u0022spread-user\u0022)\n  }\n}\n\nfragment CommentCore on Comment {\n  id\n  body\n  author {\n    ...UserCore\n  }\n}",
      "SearchWithMultipleInlineFragments": "query SearchWithMultipleInlineFragments($text: String!) {\n  results: search(text: $text) {\n    __typename\n    ... on User {\n      ...UserCore\n    }\n    ... on User @opTag(name: \u0022user-posts\u0022) {\n      posts {\n        ...PostCore\n      }\n    }\n    ... on Post {\n      ...PostCore\n    }\n    ... on Post @opTag(name: \u0022post-author\u0022) {\n      author {\n        ...UserCore\n      }\n    }\n    ... on Comment {\n      ...CommentCore\n    }\n  }\n}\n\nfragment UserCore on User @opTag(name: \u0022frag-user\u0022) {\n  id\n  name\n  role\n  createdAt\n}\n\nfragment PostCore on Post @opTag(name: \u0022frag-post\u0022) {\n  id\n  title\n  content\n  author {\n    ...UserCore @opTag(name: \u0022spread-user\u0022)\n  }\n}\n\nfragment CommentCore on Comment {\n  id\n  body\n  author {\n    ...UserCore\n  }\n}",
      "UnusedVar": "query UnusedVar {\n  users {\n    id\n  }\n}",
      "UpdatePostWithDefaults": "mutation UpdatePostWithDefaults($id: ID! = \u00221\u0022, $input: CreatePostInput = {title: \u0022t\u0022, content: \u0022c\u0022, tags: [\u0022x\u0022], meta: {rating: 2, flags: [\u0022f\u0022]}}) {\n  updatePost(id: $id, input: $input) @opTag(name: \u0022update\u0022) {\n    ...PostCore\n  }\n}\n\nfragment UserCore on User @opTag(name: \u0022frag-user\u0022) {\n  id\n  name\n  role\n  createdAt\n}\n\nfragment PostCore on Post @opTag(name: \u0022frag-post\u0022) {\n  id\n  title\n  content\n  author {\n    ...UserCore @opTag(name: \u0022spread-user\u0022)\n  }\n}",
      "UsersByRole": "query UsersByRole($role: Role = ADMIN, $filter: UserFilter = {roles: [USER], ids: [\u00221\u0022]}) @opTag(name: \u0022users-by-role\u0022) {\n  admins: users(role: $role, filter: $filter) {\n    ...UserCore\n    posts {\n      ...PostCore\n    }\n  }\n  guests: users(role: GUEST) @skip(if: false) {\n    ...UserCore\n  }\n}\n\nfragment UserCore on User @opTag(name: \u0022frag-user\u0022) {\n  id\n  name\n  role\n  createdAt\n}\n\nfragment PostCore on Post @opTag(name: \u0022frag-post\u0022) {\n  id\n  title\n  content\n  author {\n    ...UserCore @opTag(name: \u0022spread-user\u0022)\n  }\n}",
      "UsersDefaultRole": "query UsersDefaultRole @opTag(name: \u0022users-default\u0022) {\n  users @opTag(name: \u0022users-field\u0022) {\n    ...UserCore @opTag(name: \u0022spread-user\u0022)\n  }\n}\n\nfragment UserCore on User @opTag(name: \u0022frag-user\u0022) {\n  id\n  name\n  role\n  createdAt\n}"
