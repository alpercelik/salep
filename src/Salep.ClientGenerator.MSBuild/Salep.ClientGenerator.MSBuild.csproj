<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Salep.ClientGenerator</PackageId>
    <Title>Salep C# Client Generator</Title>
    <Description>Build-time GraphQL C# client generation with consumer-overridable Scriban templates.</Description>
    <PackageTags>graphql;client;code-generation;csharp;scriban;msbuild;dotnet</PackageTags>
    <PackageReadmeFile>package-readme.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <DevelopmentDependency>true</DevelopmentDependency>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <IsPackable>true</IsPackable>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_SalepPackCliTools</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Salep.ClientGenerator.Cli\Salep.ClientGenerator.Cli.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Salep.ClientGenerator.props" Pack="true" PackagePath="build" />
    <None Include="Salep.ClientGenerator.targets" Pack="true" PackagePath="build" />
    <None Include="../../docs/client-generator/config.schema.json" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../docs/client-generator/package-readme.md" Pack="true" PackagePath="/" />
    <None Include="../../docs/client-generator/third-party-notices.md" Pack="true" PackagePath="/" />
    <None Include="../../docs/client-generator/licenses/runtime-THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="licenses/" />
  </ItemGroup>

  <Target Name="_SalepPackCliTools">
    <PropertyGroup>
      <_ScribanCliPublishDir>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)scriban_cli_publish/', '$(MSBuildProjectDirectory)'))</_ScribanCliPublishDir>
    </PropertyGroup>
    <RemoveDir Directories="$(_ScribanCliPublishDir)" />
    <MSBuild Projects="..\Salep.ClientGenerator.Cli\Salep.ClientGenerator.Cli.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);PublishDir=$(_ScribanCliPublishDir)" />
    <ItemGroup>
      <_ScribanCliPublishFiles Include="$(_ScribanCliPublishDir)**/*" />
      <TfmSpecificPackageFile Include="@(_ScribanCliPublishFiles)">
        <PackagePath>tools/$(TargetFramework)/any/%(RecursiveDir)%(FileName)%(Extension)</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>
</Project>
